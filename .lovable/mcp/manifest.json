{
  "version": 1,
  "sdk_version": "0.22.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://jwlbsedspzeksghiffri.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "frag-avenue-mcp",
      "version": "0.1.0",
      "title": "FRAG AVENUE"
    },
    "tools": [
      {
        "name": "list_products",
        "title": "List products",
        "description": "Search or browse the FRAG AVENUE perfume catalog. Filter by search text, brand slug, category slug, or new/featured/discounted flags.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "description": "Optional search text matched against product name.",
              "type": "string",
              "maxLength": 120
            },
            "brand_slug": {
              "type": "string",
              "maxLength": 80
            },
            "category_slug": {
              "type": "string",
              "maxLength": 80
            },
            "is_new": {
              "type": "boolean"
            },
            "is_featured": {
              "type": "boolean"
            },
            "is_discounted": {
              "type": "boolean"
            },
            "limit": {
              "description": "Max products to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "get_product",
        "title": "Get product details",
        "description": "Fetch full details for a single perfume by its slug: description, notes, variants (size/price/stock), brand, and category.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "slug": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "description": "The product slug, e.g. \"fakhar\"."
            }
          },
          "required": [
            "slug"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_my_orders",
        "title": "List my orders",
        "description": "List the signed-in user's orders on FRAG AVENUE, most recent first.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max orders to return (default 20).",
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_my_wishlist",
        "title": "List my wishlist",
        "description": "List the products the signed-in user has added to their FRAG AVENUE wishlist.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
